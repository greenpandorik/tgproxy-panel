        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "pointSize": 5,
            "spanNulls": true,
            "lineInterpolation": "linear",
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "streams",
            "stacking": { "mode": "none", "group": "A" }
          },
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": []
        },
        "overrides": []
