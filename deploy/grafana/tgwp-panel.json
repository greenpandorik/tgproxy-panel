        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "pluginVersion": "10.0.0"
    },
    {
      "id": 10,
      "type": "table",
      "title": "Sessions live by node",
      "description": "tgwp_node_sessions_live, instant",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "tgwp_node_sessions_live",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "mappings": [],
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Node", "desc": false }]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "job": true, "instance": true },
            "indexByName": {},
            "renameByName": { "node": "Node", "Value": "Sessions live" }
          }
        }
      ],
      "pluginVersion": "10.0.0"
    },
    {
      "id": 11,
      "type": "text",
      "title": "Documentation",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 24 },
      "options": {
        "mode": "markdown",
        "content": "**tgwp-panel monitoring** — see `docs/monitoring.md` in the panel repository for the metric reference, per-node relay metrics (read through the panel UI, not scraped here — cookie-authenticated), and a note that per-key statistics are not available (relay limitation: no per-profile label)."
      },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "pluginVersion": "10.0.0"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["tgwp", "prometheus"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "TGWP Panel",
  "uid": "tgwp-panel",
  "version": 1,
  "weekStart": ""
