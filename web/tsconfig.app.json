{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness. noUnusedLocals/Parameters are left to ESLint instead of tsc:
       shadcn-generated files under components/ui import `React` unconditionally
       for its namespace types, which tsc's unused-locals check flags as dead in
       files that end up only using named imports. */
    "strict": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Path aliases (shadcn/ui) */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
