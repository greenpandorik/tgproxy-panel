#!/usr/bin/env bash
{{if .IsTelemt}}# Generated by the panel for {{sq .Hostname}}. Installs telemt + Caddy + tgwp-agent.{{else}}# Generated by the panel for {{sq .Hostname}}. Installs tproxy-server + MTProxy + Caddy + tgwp-agent.{{end}}
#
# Knobs, passed as environment (curl … | sudo VAR=1 bash):
#   TGWP_SKIP_PREFLIGHT=1   show the pre-flight checks but never stop on a failed dns/ports check
#   TGWP_DRY_RUN=1          stop right after the pre-flight checks; installs nothing
#   TGWP_PUBLIC_IP=a.b.c.d  use this as the server's public IPv4 instead of detecting it
set -Eeuo pipefail
umask 022
PANEL_URL={{sq .PanelURL}}
INSTALL_TOKEN={{sq .InstallToken}}
NODE_HOSTNAME={{sq .Hostname}}
ACME_EMAIL={{sq .ACMEEmail}}
WEB_SECRET={{sq .Secret}}
PANEL_PUBLIC_IP={{sq .PublicIP}}
{{if .IsTelemt}}WEB_USER={{sq .WebUser}}
TLS_DOMAIN={{sq .TLSDomain}}
CLASSIC_PORT={{sq (printf "%d" .ClassicPort)}}
TELEMT_VERSION={{sq .TelemtVersion}}
TELEMT_SHA256={{sq .TelemtSHA256}}
{{else}}TPROXY_COMMIT={{sq .TProxyCommit}}
{{end}}AGENT_SHA256={{sq .AgentSHA256}}
SITE_TAR_B64={{sq .SiteTarB64}}

# ---- output helpers (same style as the panel's install.sh) ---------------------------
IS_TTY=0
if [[ -t 1 ]]; then IS_TTY=1; fi
if [[ "$IS_TTY" -eq 1 && -z "${NO_COLOR:-}" ]]; then
  GREEN=$'\033[32m' RED=$'\033[31m' YELLOW=$'\033[33m' DIM=$'\033[2m' BOLD=$'\033[1m' RESET=$'\033[0m'
else
  GREEN='' RED='' YELLOW='' DIM='' BOLD='' RESET=''
fi
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) M_OK='✔' M_FAIL='✘' M_WAIT='…' M_ARROW='→' ;;
  *) M_OK='[ok]' M_FAIL='[x]' M_WAIT='[..]' M_ARROW='->' ;;
esac
step() { printf '\n%s==> %s%s\n' "$BOLD" "$1" "$RESET"; }
ok() { printf '  %s%s%s %s\n' "$GREEN" "$M_OK" "$RESET" "$1"; }
fail() { printf '  %s%s%s %s\n' "$RED" "$M_FAIL" "$RESET" "$1" >&2; }
warn() { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$1"; }
info() { printf '    %s%s%s\n' "$DIM" "$1" "$RESET"; }

# wait_for "label" <seconds> <cmd...>: polls cmd once a second for up to <seconds>. On a tty
# the line is redrawn with the elapsed time every 5 s; in a log it is one line at the start
# and one at the end. Returns 0 as soon as cmd does, 1 when the time is up.
wait_for() {
  local label=$1 secs=$2 i=0
  shift 2
  if [[ "$IS_TTY" -eq 1 ]]; then printf '  %s %s' "$M_WAIT" "$label"; else echo "  $M_WAIT $label (up to ${secs}s)"; fi
  while :; do
    if "$@" >/dev/null 2>&1; then
      if [[ "$IS_TTY" -eq 1 ]]; then printf '\r\033[K'; fi
      ok "$label (${i}s)"
      return 0
    fi
    if [[ "$i" -ge "$secs" ]]; then break; fi
    sleep 1
    i=$((i + 1))
    if [[ "$IS_TTY" -eq 1 && $((i % 5)) -eq 0 ]]; then printf '\r\033[K  %s %s (%ds)' "$M_WAIT" "$label" "$i"; fi
  done
  if [[ "$IS_TTY" -eq 1 ]]; then printf '\r\033[K'; fi
  fail "$label: still not ready after ${secs}s"
  return 1
}

banner() {
  local color=$1 w=0 line rule
  shift
  for line in "$@"; do if [[ ${#line} -gt $w ]]; then w=${#line}; fi; done
  rule="+$(printf '%*s' $((w + 2)) '' | tr ' ' '-')+"
  echo
  printf '%s%s%s\n' "$color" "$rule" "$RESET"
  for line in "$@"; do printf '%s|%s %-*s %s|%s\n' "$color" "$RESET" "$w" "$line" "$color" "$RESET"; done
  printf '%s%s%s\n' "$color" "$rule" "$RESET"
}
banner_ok() { banner "$GREEN" "$@"; }
banner_fail() { banner "$RED" "$@" >&2; }

# quiet <cmd...>: runs cmd with its output captured; only on failure are the last 30 lines shown.
quiet() {
  local log st=0
  log="$(mktemp /tmp/tgwp-quiet.XXXXXX)"
  "$@" >"$log" 2>&1 || st=$?
  if [[ "$st" -ne 0 ]]; then
    fail "$1 failed (exit $st); the last 30 lines of its output:"
    tail -n 30 "$log" >&2
  fi
  rm -f "$log"
  return "$st"
}

# STAGE tells a failure message what the operator can do next. Registration is the one step
# that cannot be repeated (the install token is single-use), so it runs last, and everything
# before it may simply be run again with the same command.
STAGE=preflight
rerun_hint() {
  case "$STAGE" in
    preflight) info "Nothing was installed. Fix the cause and run the same command again." ;;
    install) info "The node is not registered yet, so the install token is still valid: fix the cause and run the same command again." ;;
    registered) info "The node is registered and the install token is used up. Check the agent: journalctl -u tgwp-agent -n 30" ;;
  esac
}
die() {
  fail "$1"
  shift
  local l
  for l in "$@"; do info "$l"; done
  if [[ "$STAGE" != preflight ]]; then
    rerun_hint
    banner_fail "Installation of $NODE_HOSTNAME failed."
  fi
  exit 1
}
on_err() {
  local st=$1 line=$2
  # A failure inside $(...) reaches the parent as a failed assignment and is reported there.
  if [[ "${BASH_SUBSHELL:-0}" -gt 0 ]]; then return; fi
  fail "command failed (exit $st) at line $line: $BASH_COMMAND"
  rerun_hint
  banner_fail "Installation of $NODE_HOSTNAME failed."
}
trap 'on_err $? $LINENO' ERR

if [[ "${EUID}" -ne 0 ]]; then fail "run as root (sudo bash)"; exit 1; fi
printf '%sTGProxy node installer%s  %s  (engine: %s)\n' "$BOLD" "$RESET" "$NODE_HOSTNAME" {{if .IsTelemt}}telemt{{else}}tproxy{{end}}

# ---- pre-flight ------------------------------------------------------------------------
# Everything here is read-only. The single most common install failure is an A record that
# does not point at this host: Caddy then never gets a certificate, and before this block the
# script found that out only after installing everything and burning the install token.
IPV4_RE='^[0-9]{1,3}(\.[0-9]{1,3}){3}$'
PUBLIC_IP='' PUBLIC_IP_SRC='' PUBLIC_IP_BOTH=''
{{if .IsTelemt}}ALLOWED_UNITS='caddy.service telemt.service'
{{else}}ALLOWED_UNITS='caddy.service tproxy-server.service mtproxy.service'
{{end}}PF_SOFT=0 PF_FATAL=0 PF_DNS=0

# is_public_ipv4 <a.b.c.d>: false for the ranges that can never be an internet-facing
# address - RFC 1918, CGNAT (100.64/10), loopback, link-local, 0/8, multicast and above.
is_public_ipv4() {
  local a b
  IFS=. read -r a b _ _ <<<"$1"
  case "$a" in
    0 | 10 | 127) return 1 ;;
    100) if [[ "$b" -ge 64 && "$b" -le 127 ]]; then return 1; fi ;;
    169) if [[ "$b" -eq 254 ]]; then return 1; fi ;;
    172) if [[ "$b" -ge 16 && "$b" -le 31 ]]; then return 1; fi ;;
    192) if [[ "$b" -eq 168 ]]; then return 1; fi ;;
  esac
  if [[ "$a" -ge 224 ]]; then return 1; fi
  return 0
}

# detect_public_ip <resolved A records of the hostname, one per line>
#
# The node is the only party that can see its own public address reliably; the dns check
# compares against it and it is reported at registration (the relay's WEB vhost needs a
# concrete address). An explicit value (TGWP_PUBLIC_IP, or public_ip set on the node in the
# panel) wins. Otherwise two candidates are collected - the address on the outbound interface
# and the address the internet sees this host as (api.ipify.org) - because on a NAT host they
# differ, and the wrong one is the one a provider's egress uses for outgoing traffic only:
# nothing listens on it, and an A record pointing at it gets "connection refused" on 80/443.
# The candidate the hostname already resolves to wins when exactly one does; failing that the
# interface address is preferred whenever it is a public one, else the internet-facing one.
# When the two differ, PUBLIC_IP_BOTH names both so the operator sees the alternative.
detect_public_ip() {
  local resolved=$1 ip='' iface='' seen='' c matches=0 match=''
  PUBLIC_IP='' PUBLIC_IP_SRC='' PUBLIC_IP_BOTH=''
  if [[ -n "${TGWP_PUBLIC_IP:-}" ]]; then
    ip="$TGWP_PUBLIC_IP" PUBLIC_IP_SRC='TGWP_PUBLIC_IP'
  elif [[ -n "$PANEL_PUBLIC_IP" ]]; then
    ip="$PANEL_PUBLIC_IP" PUBLIC_IP_SRC='set in the panel'
  else
    iface="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}' || true)"
    if [[ ! "$iface" =~ $IPV4_RE ]]; then iface=''; fi
    seen="$(curl -4fsS --max-time 10 https://api.ipify.org 2>/dev/null || true)"
    if [[ ! "$seen" =~ $IPV4_RE ]]; then seen=''; fi
    if [[ -n "$iface" && -n "$seen" && "$iface" != "$seen" ]]; then
      PUBLIC_IP_BOTH="interface $iface, seen from the internet $seen"
    fi
    for c in "$iface" "$seen"; do
      if [[ -z "$c" || "$c" == "$match" ]]; then continue; fi
      if [[ -n "$resolved" ]] && grep -qxF "$c" <<<"$resolved"; then matches=$((matches + 1)) match="$c"; fi
    done
    if [[ "$matches" -eq 1 ]]; then
      ip="$match" PUBLIC_IP_SRC='matches DNS'
    elif [[ -n "$iface" ]] && { [[ -z "$seen" ]] || is_public_ipv4 "$iface"; }; then
      ip="$iface" PUBLIC_IP_SRC='outbound interface'
    elif [[ -n "$seen" ]]; then
      ip="$seen" PUBLIC_IP_SRC='api.ipify.org'
    fi
  fi
  [[ "$ip" =~ $IPV4_RE ]] || return 1
  PUBLIC_IP="$ip"
}

# resolve_a <name>: the IPv4 addresses <name> resolves to, one per line (empty when none).
resolve_a() {
  local out
  # ahosts, not ahostsv4: the latter applies AI_ADDRCONFIG and answers nothing on a host whose
  # only IPv4 address is loopback; the IPv4 filter below does the same job without that.
  out="$(getent ahosts "$1" 2>/dev/null | awk '{print $1}' | grep -E "$IPV4_RE" | sort -u || true)"
  if [[ -z "$out" ]] && command -v dig >/dev/null 2>&1; then
    out="$(dig +short +time=3 +tries=1 A "$1" 2>/dev/null | grep -E "$IPV4_RE" | sort -u || true)"
  fi
  printf '%s' "$out"
}

pf_ok() { ok "$(printf '%-10s %s' "$1" "$2")"; }
pf_fail() { fail "$(printf '%-10s %s' "$1" "$2")"; }
pf_warn() { warn "$(printf '%-10s %s' "$1" "$2")"; }

# ports_check: 80, 443{{if .IsTelemt}} and the Fake-TLS port{{end}} must be free, except for services this script
# installed on an earlier run (recognised by the systemd unit that owns the listening pid).
ports_check() {
  local -a ports=(80 443{{if .IsTelemt}} "$CLASSIC_PORT"{{end}})
  local p line pname pid unit bad='' own='' free=''
  if ! command -v ss >/dev/null 2>&1; then
    pf_warn ports "ss (iproute2) not found; skipped the check that ${ports[*]} are free"
    return 0
  fi
  for p in "${ports[@]}"; do
    line="$(ss -ltnpH "sport = :$p" 2>/dev/null | head -n 1 || true)"
    if [[ -z "$line" ]]; then
      free="${free:+$free, }$p"
      continue
    fi
    pname="$(sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\),.*/\1/p' <<<"$line")"
    pid="$(sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\),.*/\2/p' <<<"$line")"
    unit=''
    if [[ -n "$pid" && -r "/proc/$pid/cgroup" ]]; then
      unit="$(sed -n 's#.*/\([^/]*\.service\)$#\1#p' "/proc/$pid/cgroup" | head -n 1 || true)"
    fi
    if [[ -n "$unit" && " $ALLOWED_UNITS " == *" $unit "* ]]; then
      own="${own:+$own, }$p ($unit)"
    else
      bad="${bad:+$bad; }port $p is used by ${pname:-another process}${pid:+ (pid $pid)}"
    fi
  done
  if [[ -n "$bad" ]]; then
    pf_fail ports "$bad"
    PF_SOFT=1
    return 0
  fi
  pf_ok ports "${free:+$free free}${own:+${free:+; }$own from a previous run of this script}"
}

preflight() {
  PF_SOFT=0 PF_FATAL=0 PF_DNS=0
  local arch resolved err
  arch="$(uname -m)"
  if [[ "$arch" == x86_64 ]]; then
    pf_ok arch "x86_64"
  else
    pf_fail arch "$arch is not supported ({{if .IsTelemt}}telemt is shipped for x86_64 only{{else}}x86_64 Linux is required{{end}})"
    PF_FATAL=1
  fi
  if command -v systemctl >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
    pf_ok systemd "running"
  else
    pf_fail systemd "not running (systemctl missing or /run/systemd/system absent); this installer needs systemd"
    PF_FATAL=1
  fi
  if err="$(curl -fsS --max-time 10 -o /dev/null "$PANEL_URL/healthz" 2>&1)"; then
    pf_ok panel "$PANEL_URL reachable"
  else
    pf_fail panel "$PANEL_URL/healthz is unreachable from this host (${err%%$'\n'*}); needed to register and for the agent"
    PF_FATAL=1
  fi
  # One lookup serves both the address choice and the dns check below.
  resolved="$(resolve_a "$NODE_HOSTNAME")"
  if detect_public_ip "$resolved"; then
    pf_ok public_ip "$PUBLIC_IP ($PUBLIC_IP_SRC)"
    if [[ -n "$PUBLIC_IP_BOTH" ]]; then info "$PUBLIC_IP_BOTH"; fi
  else
    pf_fail public_ip "could not detect this server's public IPv4; set public_ip on the node in the panel, or run with TGWP_PUBLIC_IP=<address>"
    PF_FATAL=1
  fi
  if [[ -z "$resolved" ]]; then
    pf_fail dns "no A record for $NODE_HOSTNAME${PUBLIC_IP:+; point it at $PUBLIC_IP}${PUBLIC_IP_BOTH:+ ($PUBLIC_IP_BOTH)}"
    PF_SOFT=1 PF_DNS=1
  elif [[ -n "$PUBLIC_IP" ]] && grep -qxF "$PUBLIC_IP" <<<"$resolved"; then
    pf_ok dns "$NODE_HOSTNAME $M_ARROW $PUBLIC_IP (this server)"
  else
    pf_fail dns "$NODE_HOSTNAME resolves to ${resolved//$'\n'/, }, this server is ${PUBLIC_IP:-unknown}${PUBLIC_IP_BOTH:+ ($PUBLIC_IP_BOTH)}"
    PF_SOFT=1 PF_DNS=1
  fi
{{if .IsTelemt}}  if [[ "$TLS_DOMAIN" != "$NODE_HOSTNAME" ]]; then
    resolved="$(resolve_a "$TLS_DOMAIN")"
    if [[ -n "$resolved" ]]; then
      pf_ok tls_domain "$TLS_DOMAIN $M_ARROW ${resolved//$'\n'/, }"
    else
      pf_warn tls_domain "$TLS_DOMAIN does not resolve; telemt copies the TLS fingerprint of this domain at startup"
    fi
  fi
{{end}}  ports_check
}

have_tty() { (: </dev/tty) 2>/dev/null; }

step "Pre-flight checks"
while :; do
  preflight
  if [[ "$PF_FATAL" -eq 1 ]]; then
    echo
    die "pre-flight failed; nothing was installed. Fix the checks marked $M_FAIL above and run the same command again."
  fi
  if [[ "$PF_SOFT" -eq 0 ]]; then break; fi
  if [[ "$PF_DNS" -eq 1 ]]; then
    PF_MSG="nothing was installed; fix the record and run the same command again"
  else
    PF_MSG="nothing was installed; free the port and run the same command again"
  fi
  if [[ "${TGWP_SKIP_PREFLIGHT:-}" == "1" ]]; then
    warn "TGWP_SKIP_PREFLIGHT=1: continuing despite the failed checks"
    break
  fi
  # The script is piped through curl | bash, so stdin is the script itself; the menu talks to
  # the terminal directly, and without one there is nobody to ask.
  if ! have_tty; then
    echo
    fail "$PF_MSG"
    info "No terminal to ask on. To continue regardless: curl … | sudo TGWP_SKIP_PREFLIGHT=1 bash"
    exit 1
  fi
  printf '\n  What now?  [r] re-run the checks   [c] continue anyway   [q] quit  ' >/dev/tty
  trap 'echo >/dev/tty; fail "$PF_MSG"; exit 1' INT
  read -r -n 1 PF_ANS </dev/tty || PF_ANS=q
  trap - INT
  echo >/dev/tty
  case "$PF_ANS" in
    r | R) echo ;;
    c | C)
      warn "continuing anyway; the certificate wait below will fail if the record is still wrong"
      break
      ;;
    *)
      fail "$PF_MSG"
      exit 1
      ;;
  esac
done
if [[ "${TGWP_DRY_RUN:-}" == "1" ]]; then
  info "dry run: stopping before installation"
  exit 0
fi
STAGE=install

# ---- packages --------------------------------------------------------------------------
step "Packages"
export DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a
APT=(apt-get -qq -o Dpkg::Use-Pty=0)
quiet "${APT[@]}" update || die "apt-get update failed; check the apt sources and the network"
{{if .IsTelemt}}quiet "${APT[@]}" install -y --no-install-recommends ca-certificates curl nftables tar || die "apt-get install failed"
ok "ca-certificates curl nftables tar"
{{else}}quiet "${APT[@]}" install -y --no-install-recommends git ca-certificates curl tar || die "apt-get install failed"
ok "git ca-certificates curl tar"
{{end}}{{if .SysctlTuning}}
# Network tuning for a proxy node (adopted from MTPROTO_FIX_By_MEKO): BBR + fq, larger accept
# and SYN backlogs, TCP Fast Open, keepalives short enough to notice a dead client in about a
# minute. A kernel that rejects a key (container, old kernel) must not abort the install, so
# the apply step is guarded and only reports; the file itself is safe to delete.
install -d -m 0755 /etc/sysctl.d
cat > /etc/sysctl.d/90-tgwp.conf <<'EOF'
# TGProxy panel: network tuning for proxy nodes (adopted from MTPROTO_FIX_By_MEKO)
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_keepalive_time = 45
net.ipv4.tcp_keepalive_intvl = 15
net.ipv4.tcp_keepalive_probes = 3
EOF
chmod 0644 /etc/sysctl.d/90-tgwp.conf
modprobe tcp_bbr 2>/dev/null || true
if sysctl --system >/dev/null; then
  ok "network tuning applied from /etc/sysctl.d/90-tgwp.conf"
else
  warn "some sysctl keys could not be applied (see the lines above; container or old kernel); continuing"
fi
{{end}}
{{if .IsTelemt}}# ---- Caddy -----------------------------------------------------------------------------
# Caddy terminates TLS on 443 and forwards to telemt's loopback WEB listener. It comes from
# the Caddy project's own apt repository, signed with its release key, so apt verifies the
# package the same way it verifies the distribution's own.
step "Caddy"
install -d -m 0755 /usr/share/keyrings
curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/gpg.key -o /usr/share/keyrings/caddy-stable.asc
chmod 0644 /usr/share/keyrings/caddy-stable.asc
echo 'deb [signed-by=/usr/share/keyrings/caddy-stable.asc] https://dl.cloudsmith.io/public/caddy/stable/deb/debian any-version main' > /etc/apt/sources.list.d/caddy-stable.list
quiet "${APT[@]}" update || die "apt-get update failed after adding the Caddy repository"
quiet "${APT[@]}" install -y --no-install-recommends caddy || die "apt-get install caddy failed"
ok "caddy installed from the Caddy apt repository"

# Caddy serves nothing from disk on purpose: telemt answers the decoy site itself
# (web.vhosts.decoy), so a request without a valid secret gets exactly the same reply, from
# exactly the same process, as a proxied one.
install -d -m 0755 /etc/caddy
cat > /etc/caddy/Caddyfile <<EOF
{
	email $ACME_EMAIL
	servers {
		trusted_proxies static private_ranges
	}
}

$NODE_HOSTNAME {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18080 {
		header_up X-Forwarded-For {remote_host}
	}
}
EOF
# Caddy FIRST, and only once it actually serves the hostname over TLS. telemt learns the TLS
# fingerprint of its tls_domain by connecting to it on 443 at startup, and a runtime reload
# refuses to activate a generation whose TLS-front profile is still the built-in fallback
# ("TLS-front profiles are not ready for domains: ..."). Starting telemt before Caddy holds a
# certificate makes the node's first applies roll back, so the wait is not optional.
systemctl -q enable caddy
systemctl restart caddy
ok "/etc/caddy/Caddyfile written, caddy started"
caddy_ready() { curl -sS -o /dev/null --max-time 5 --resolve "$NODE_HOSTNAME:443:127.0.0.1" "https://$NODE_HOSTNAME/"; }
wait_for "certificate for $NODE_HOSTNAME" 120 caddy_ready || {
  journalctl -u caddy -n 30 --no-pager >&2 || true
  die "Caddy did not serve https://$NODE_HOSTNAME/ with a valid certificate within 120s" \
    "The A record for $NODE_HOSTNAME must point at this host ($PUBLIC_IP${PUBLIC_IP_BOTH:+; $PUBLIC_IP_BOTH}) and ports 80 and 443 must be reachable from the internet." \
    "Caddy's log: journalctl -u caddy -n 30"
}

# ---- telemt ----------------------------------------------------------------------------
step "telemt"
# The release the panel pins, checked against the panel's sha256 before it is ever made
# executable.
TELEMT_TGZ="$(mktemp /tmp/telemt.XXXXXX.tar.gz)"
TELEMT_UNPACK="$(mktemp -d /tmp/telemt-unpack.XXXXXX)"
curl -fsSL -o "$TELEMT_TGZ" "https://github.com/telemt/telemt/releases/download/$TELEMT_VERSION/telemt-x86_64-linux-gnu.tar.gz"
echo "$TELEMT_SHA256  $TELEMT_TGZ" | sha256sum -c --quiet - || die "telemt $TELEMT_VERSION tarball does not match the panel's sha256 (TELEMT_SHA256_X86_64)"
tar -xzf "$TELEMT_TGZ" -C "$TELEMT_UNPACK"
TELEMT_SRC="$(find "$TELEMT_UNPACK" -type f -name telemt -print -quit)"
if [[ -z "$TELEMT_SRC" ]]; then die "no telemt binary in the release tarball"; fi
install -o root -g root -m 0755 "$TELEMT_SRC" /usr/local/bin/telemt
rm -rf "$TELEMT_TGZ" "$TELEMT_UNPACK"
ok "telemt $TELEMT_VERSION downloaded, sha256 verified, installed to /usr/local/bin/telemt"

# The unit runs unprivileged. init-node chowns /etc/telemt and /var/lib/telemt to this account
# and fails if it is missing, so it is created before init-node runs.
id -u telemt >/dev/null 2>&1 || useradd --system --home /var/lib/telemt --shell /usr/sbin/nologin telemt

# telemt binds its control API (9091), metrics (9090) and the WEB listener (18080) to loopback
# already; this table is the second lock on them. 80, 443 and the Fake-TLS port stay open.
install -d -m 0755 /etc/nftables.d
cat > /etc/nftables.d/tgwp-telemt.nft <<'EOF'
#!/usr/sbin/nft -f
table inet tgwp_telemt
delete table inet tgwp_telemt
table inet tgwp_telemt {
	chain input {
		type filter hook input priority filter; policy accept;
		iif lo accept
		tcp dport { 9090, 9091, 18080 } drop
	}
}
EOF
chmod 0644 /etc/nftables.d/tgwp-telemt.nft
nft -f /etc/nftables.d/tgwp-telemt.nft
touch /etc/nftables.conf
grep -q '/etc/nftables.d/tgwp-telemt.nft' /etc/nftables.conf || printf 'include "/etc/nftables.d/tgwp-telemt.nft"\n' >> /etc/nftables.conf
systemctl -q enable nftables >/dev/null 2>&1 || true
ok "control API, metrics and the WEB listener locked to loopback (nftables)"
{{else}}# ---- tproxy-server + MTProxy ----------------------------------------------------------
step "tproxy-server + MTProxy"
SRC=/opt/tproxy-server-src
if [[ ! -d "$SRC/.git" ]]; then quiet git clone https://github.com/telegramdesktop/tproxy-server.git "$SRC" || die "git clone of tproxy-server failed"; fi
quiet git -C "$SRC" fetch --depth 1 origin "$TPROXY_COMMIT" || quiet git -C "$SRC" fetch origin || die "git fetch of tproxy-server failed"
git -C "$SRC" checkout -q {{sq .TProxyCommit}}
ok "tproxy-server source at commit $TPROXY_COMMIT"
{{end}}
SITE_DIR="$(mktemp -d /tmp/tgwp-site.XXXXXX)"
echo "$SITE_TAR_B64" | base64 -d | tar -xz -C "$SITE_DIR"
{{if not .IsTelemt}}
if [[ ! -x /usr/local/bin/tproxy-server ]]; then
  tproxy_install() { (cd "$SRC" && ./deploy/install.sh --hostname {{sq .Hostname}} --email "$ACME_EMAIL" --secret "$WEB_SECRET" --site-dir "$SITE_DIR"); }
  quiet tproxy_install || die "the upstream tproxy-server installer (deploy/install.sh) failed"
  ok "tproxy-server, MTProxy and Caddy installed by the upstream installer"
else
  ok "tproxy-server already installed, upstream installer skipped"
fi
{{end}}
# The agent binary comes from the panel and is verified against the checksum the panel
# published with it.
curl -fsSL -o /usr/local/bin/tgwp-agent.new "$PANEL_URL/api/v1/install/agent/linux-amd64"
echo "$AGENT_SHA256  /usr/local/bin/tgwp-agent.new" | sha256sum -c --quiet - || die "tgwp-agent download does not match the panel's checksum (was the agent rebuilt while this script ran? run the same command again)"
chmod 0755 /usr/local/bin/tgwp-agent.new
mv -f /usr/local/bin/tgwp-agent.new /usr/local/bin/tgwp-agent
ok "tgwp-agent $(/usr/local/bin/tgwp-agent version) downloaded and verified"

{{if .IsTelemt}}/usr/local/bin/tgwp-agent init-node --engine telemt --hostname "$NODE_HOSTNAME" --public-ip "$PUBLIC_IP" \
  --tls-domain "$TLS_DOMAIN" --classic-port "$CLASSIC_PORT" --web-user "$WEB_USER" --web-secret "$WEB_SECRET" \
  --site-dir "$SITE_DIR"
ok "/etc/telemt/telemt.toml, the control-API token and the decoy site written (init-node)"
systemctl daemon-reload
quiet systemctl enable --now telemt || die "telemt did not start" "telemt's log: journalctl -u telemt -n 30"
# The control API is the agent's only channel to the relay, so the agent is not started until
# telemt reports itself ready on it - listening is not the same as able to serve. The token
# file is written by init-node, 0600; tr strips the trailing newline so the header is the
# exact value telemt compares against. The header goes in on stdin (-H @-) rather than as an
# argument, so the token never appears in /proc/*/cmdline, and it is never echoed.
TELEMT_API_TOKEN="$(tr -d '\r\n' < /etc/telemt/api.token)"
telemt_ready() {
  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' -H @- http://127.0.0.1:9091/v1/health/ready <<<"Authorization: $TELEMT_API_TOKEN")" || return 1
  [[ "$code" == "200" ]]
}
wait_for "telemt ready on its control API" 60 telemt_ready || {
  journalctl -u telemt -n 30 --no-pager >&2 || true
  die "telemt did not report ready on /v1/health/ready within 60s" \
    "telemt needs outbound access to the Telegram DCs, and to $TLS_DOMAIN:443 for its TLS fingerprint, at startup." \
    "telemt's log: journalctl -u telemt -n 30"
}
unset TELEMT_API_TOKEN
{{else}}/usr/local/bin/tgwp-agent init-node --config /etc/tproxy-server/config.json --mtproxy-env /etc/mtproxy/mtproxy.env \
  --dropin /etc/systemd/system/mtproxy.service.d/secrets.conf --max-profiles 128
ok "tproxy-server config and MTProxy environment written (init-node)"
systemctl daemon-reload
quiet systemctl restart mtproxy tproxy-server || die "mtproxy/tproxy-server did not start" "logs: journalctl -u tproxy-server -n 30; journalctl -u mtproxy -n 30"
ok "mtproxy and tproxy-server restarted with the node's configuration"

# ---- Caddy -----------------------------------------------------------------------------
# The upstream installer set Caddy up for the hostname; the node is not registered until it
# actually serves the hostname over TLS, because a wrong A record is the usual reason it
# never will, and the install token must survive that.
step "Caddy"
systemctl restart caddy
caddy_ready() { curl -sS -o /dev/null --max-time 5 --resolve "$NODE_HOSTNAME:443:127.0.0.1" "https://$NODE_HOSTNAME/"; }
wait_for "certificate for $NODE_HOSTNAME" 120 caddy_ready || {
  journalctl -u caddy -n 30 --no-pager >&2 || true
  die "Caddy did not serve https://$NODE_HOSTNAME/ with a valid certificate within 120s" \
    "The A record for $NODE_HOSTNAME must point at this host ($PUBLIC_IP${PUBLIC_IP_BOTH:+; $PUBLIC_IP_BOTH}) and ports 80 and 443 must be reachable from the internet." \
    "Caddy's log: journalctl -u caddy -n 30"
}
{{end}}
# ---- registration ----------------------------------------------------------------------
# Last on purpose: the install token is single-use, so nothing that can still fail runs
# after this point except starting the agent.
step "Registration"
REG_URL="$PANEL_URL/api/v1/install/$INSTALL_TOKEN/register"
{{if .IsTelemt}}REG_BODY="{\"hostname\":\"$NODE_HOSTNAME\",\"public_ip\":\"$PUBLIC_IP\",\"tproxy_version\":\"telemt $TELEMT_VERSION\",\"agent_version\":\"$(/usr/local/bin/tgwp-agent version)\"}"
{{else}}REG_BODY="{\"hostname\":\"$NODE_HOSTNAME\",\"public_ip\":\"$PUBLIC_IP\",\"tproxy_version\":\"$TPROXY_COMMIT\",\"agent_version\":\"$(/usr/local/bin/tgwp-agent version)\"}"
{{end}}REG="$(curl -sS -X POST -H 'Content-Type: application/json' -d "$REG_BODY" -w '\n%{http_code}' "$REG_URL")" || REG=$'\n000'
REG_CODE="${REG##*$'\n'}"
REG="${REG%$'\n'*}"
NODE_TOKEN="$(printf '%s' "$REG" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
if [[ "$REG_CODE" != "200" || -z "$NODE_TOKEN" ]]; then
  # The body is an error document, but a token is never echoed even if one were in it.
  REG_ERR="$(printf '%s' "$REG" | sed 's/"token":"[^"]*"/"token":"…"/' | head -c 300)"
  die "registration failed (HTTP $REG_CODE): ${REG_ERR:-no response}" \
    "A 404 means the install token was already used or has expired (24h): generate a new command from the node's page in the panel and run it here."
fi
STAGE=registered
ok "registered with the panel as $NODE_HOSTNAME"

# ---- agent -----------------------------------------------------------------------------
step "Agent"
install -d -m 0700 /etc/tgwp-agent /var/lib/tgwp-agent
umask 077
cat > /etc/tgwp-agent/agent.env <<EOF
TGWP_PANEL_URL=$PANEL_URL
TGWP_TOKEN=$NODE_TOKEN
{{if .IsTelemt}}TGWP_ENGINE=telemt
{{else}}TGWP_TPROXY_VERSION=$TPROXY_COMMIT
{{end}}EOF
umask 022
cat > /etc/systemd/system/tgwp-agent.service <<'EOF'
[Unit]
Description=WEB proxy panel node agent
After=network-online.target {{if .IsTelemt}}telemt.service{{else}}tproxy-server.service{{end}}
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tgwp-agent/agent.env
ExecStart=/usr/local/bin/tgwp-agent
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
quiet systemctl enable --now tgwp-agent || die "tgwp-agent did not start" "the agent's log: journalctl -u tgwp-agent -n 30"
ok "tgwp-agent running (follow it with: journalctl -u tgwp-agent -f)"

{{if .IsTelemt}}banner_ok "Node $NODE_HOSTNAME is registered with the panel." \
  "WEB:      https://$NODE_HOSTNAME/" \
  "Fake-TLS: $NODE_HOSTNAME:$CLASSIC_PORT (SNI $TLS_DOMAIN)"
{{else}}banner_ok "Node $NODE_HOSTNAME is registered with the panel." \
  "WEB: https://$NODE_HOSTNAME/"
{{end}}info "The node's page in the panel shows it online within a minute."
