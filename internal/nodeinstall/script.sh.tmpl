#!/usr/bin/env bash
{{if .IsTelemt}}# Generated by the panel for {{sq .Hostname}}. Installs telemt + Caddy + tgwp-agent.{{else}}# Generated by the panel for {{sq .Hostname}}. Installs tproxy-server + MTProxy + Caddy + tgwp-agent.{{end}}
set -euo pipefail
umask 022
PANEL_URL={{sq .PanelURL}}
INSTALL_TOKEN={{sq .InstallToken}}
NODE_HOSTNAME={{sq .Hostname}}
ACME_EMAIL={{sq .ACMEEmail}}
WEB_SECRET={{sq .Secret}}
{{if .IsTelemt}}WEB_USER={{sq .WebUser}}
TLS_DOMAIN={{sq .TLSDomain}}
CLASSIC_PORT={{sq (printf "%d" .ClassicPort)}}
TELEMT_VERSION={{sq .TelemtVersion}}
TELEMT_SHA256={{sq .TelemtSHA256}}
{{else}}TPROXY_COMMIT={{sq .TProxyCommit}}
{{end}}AGENT_SHA256={{sq .AgentSHA256}}
SITE_TAR_B64={{sq .SiteTarB64}}

if [[ "${EUID}" -ne 0 ]]; then echo "run as root" >&2; exit 1; fi
if [[ "$(uname -m)" != "x86_64" ]]; then echo "x86_64 Linux is required" >&2; exit 1; fi
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends {{if .IsTelemt}}ca-certificates curl nftables tar{{else}}git ca-certificates curl tar{{end}}
{{if .SysctlTuning}}
# Network tuning for a proxy node (adopted from MTPROTO_FIX_By_MEKO): BBR + fq, larger accept
# and SYN backlogs, TCP Fast Open, keepalives short enough to notice a dead client in about a
# minute. A kernel that rejects a key (container, old kernel) must not abort the install, so
# the apply step is guarded and only reports; the file itself is safe to delete.
install -d -m 0755 /etc/sysctl.d
cat > /etc/sysctl.d/90-tgwp.conf <<'EOF'
# TGProxy panel: network tuning for proxy nodes (adopted from MTPROTO_FIX_By_MEKO)
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.somaxconn = 65535
net.ipv4.tcp_max_syn_backlog = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_fastopen = 3
net.ipv4.tcp_keepalive_time = 45
net.ipv4.tcp_keepalive_intvl = 15
net.ipv4.tcp_keepalive_probes = 3
EOF
chmod 0644 /etc/sysctl.d/90-tgwp.conf
modprobe tcp_bbr 2>/dev/null || true
sysctl --system >/dev/null || echo "tgwp: some sysctl keys could not be applied (see the lines above; container or old kernel); continuing"
{{end}}
{{if .IsTelemt}}# Caddy terminates TLS on 443 and forwards to telemt's loopback WEB listener. It comes from
# the Caddy project's own apt repository, signed with its release key, so apt verifies the
# package the same way it verifies the distribution's own.
install -d -m 0755 /usr/share/keyrings
curl -fsSL https://dl.cloudsmith.io/public/caddy/stable/gpg.key -o /usr/share/keyrings/caddy-stable.asc
chmod 0644 /usr/share/keyrings/caddy-stable.asc
echo 'deb [signed-by=/usr/share/keyrings/caddy-stable.asc] https://dl.cloudsmith.io/public/caddy/stable/deb/debian any-version main' > /etc/apt/sources.list.d/caddy-stable.list
apt-get update
apt-get install -y --no-install-recommends caddy

# Caddy serves nothing from disk on purpose: telemt answers the decoy site itself
# (web.vhosts.decoy), so a request without a valid secret gets exactly the same reply, from
# exactly the same process, as a proxied one.
install -d -m 0755 /etc/caddy
cat > /etc/caddy/Caddyfile <<EOF
{
	email $ACME_EMAIL
	servers {
		trusted_proxies static private_ranges
	}
}

$NODE_HOSTNAME {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18080 {
		header_up X-Forwarded-For {remote_host}
	}
}
EOF

# telemt itself: the release the panel pins, checked against the panel's sha256 before it is
# ever made executable.
TELEMT_TGZ="$(mktemp /tmp/telemt.XXXXXX.tar.gz)"
TELEMT_UNPACK="$(mktemp -d /tmp/telemt-unpack.XXXXXX)"
curl -fsSL -o "$TELEMT_TGZ" "https://github.com/telemt/telemt/releases/download/$TELEMT_VERSION/telemt-x86_64-linux-gnu.tar.gz"
echo "$TELEMT_SHA256  $TELEMT_TGZ" | sha256sum -c -
tar -xzf "$TELEMT_TGZ" -C "$TELEMT_UNPACK"
TELEMT_SRC="$(find "$TELEMT_UNPACK" -type f -name telemt -print -quit)"
if [[ -z "$TELEMT_SRC" ]]; then echo "no telemt binary in the release tarball" >&2; exit 1; fi
install -o root -g root -m 0755 "$TELEMT_SRC" /usr/local/bin/telemt
rm -rf "$TELEMT_TGZ" "$TELEMT_UNPACK"

# The unit runs unprivileged. init-node chowns /etc/telemt and /var/lib/telemt to this account
# and fails if it is missing, so it is created before init-node runs.
id -u telemt >/dev/null 2>&1 || useradd --system --home /var/lib/telemt --shell /usr/sbin/nologin telemt

# telemt binds its control API (9091), metrics (9090) and the WEB listener (18080) to loopback
# already; this table is the second lock on them. 80, 443 and the Fake-TLS port stay open.
install -d -m 0755 /etc/nftables.d
cat > /etc/nftables.d/tgwp-telemt.nft <<'EOF'
#!/usr/sbin/nft -f
table inet tgwp_telemt
delete table inet tgwp_telemt
table inet tgwp_telemt {
	chain input {
		type filter hook input priority filter; policy accept;
		iif lo accept
		tcp dport { 9090, 9091, 18080 } drop
	}
}
EOF
chmod 0644 /etc/nftables.d/tgwp-telemt.nft
nft -f /etc/nftables.d/tgwp-telemt.nft
touch /etc/nftables.conf
grep -q '/etc/nftables.d/tgwp-telemt.nft' /etc/nftables.conf || printf 'include "/etc/nftables.d/tgwp-telemt.nft"\n' >> /etc/nftables.conf
systemctl enable nftables >/dev/null 2>&1 || true
{{else}}SRC=/opt/tproxy-server-src
if [[ ! -d "$SRC/.git" ]]; then git clone https://github.com/telegramdesktop/tproxy-server.git "$SRC"; fi
git -C "$SRC" fetch --depth 1 origin "$TPROXY_COMMIT" || git -C "$SRC" fetch origin
git -C "$SRC" checkout -q {{sq .TProxyCommit}}
{{end}}
SITE_DIR="$(mktemp -d /tmp/tgwp-site.XXXXXX)"
echo "$SITE_TAR_B64" | base64 -d | tar -xz -C "$SITE_DIR"
{{if not .IsTelemt}}
if [[ ! -x /usr/local/bin/tproxy-server ]]; then
  (cd "$SRC" && ./deploy/install.sh --hostname {{sq .Hostname}} --email "$ACME_EMAIL" --secret "$WEB_SECRET" --site-dir "$SITE_DIR")
else
  echo "tproxy-server already installed, skipping official installer"
fi
{{end}}
curl -fsSL -o /usr/local/bin/tgwp-agent.new "$PANEL_URL/api/v1/install/agent/linux-amd64"
echo "$AGENT_SHA256  /usr/local/bin/tgwp-agent.new" | sha256sum -c -
chmod 0755 /usr/local/bin/tgwp-agent.new
mv -f /usr/local/bin/tgwp-agent.new /usr/local/bin/tgwp-agent

{{if .IsTelemt}}# telemt needs a concrete address for web.vhosts.public_addr and the node is the only party
# that can see it reliably, so it is detected here and reported at registration.
IPV4_RE='^[0-9]{1,3}(\.[0-9]{1,3}){3}$'
PUBLIC_IP="$(curl -4fsS https://api.ipify.org || ip -4 route get 1.1.1.1 | awk '{print $7; exit}')"
if [[ ! "$PUBLIC_IP" =~ $IPV4_RE ]]; then
  echo "could not detect the public IPv4 address of this node (got '$PUBLIC_IP'); set it in the panel and re-run" >&2
  exit 1
fi

/usr/local/bin/tgwp-agent init-node --engine telemt --hostname "$NODE_HOSTNAME" --public-ip "$PUBLIC_IP" \
  --tls-domain "$TLS_DOMAIN" --classic-port "$CLASSIC_PORT" --web-user "$WEB_USER" --web-secret "$WEB_SECRET" \
  --site-dir "$SITE_DIR"
{{else}}/usr/local/bin/tgwp-agent init-node --config /etc/tproxy-server/config.json --mtproxy-env /etc/mtproxy/mtproxy.env \
  --dropin /etc/systemd/system/mtproxy.service.d/secrets.conf --max-profiles 128
{{end}}systemctl daemon-reload

{{if .IsTelemt}}REG="$(curl -fsS -X POST -H 'Content-Type: application/json' \
  -d "{\"hostname\":\"$NODE_HOSTNAME\",\"public_ip\":\"$PUBLIC_IP\",\"tproxy_version\":\"telemt $TELEMT_VERSION\",\"agent_version\":\"$(/usr/local/bin/tgwp-agent version)\"}" \
  {{sq (printf "%s/api/v1/install/%s/register" .PanelURL .InstallToken)}})"
{{else}}REG="$(curl -fsS -X POST -H 'Content-Type: application/json' \
  -d "{\"hostname\":\"$NODE_HOSTNAME\",\"tproxy_version\":\"$TPROXY_COMMIT\",\"agent_version\":\"$(/usr/local/bin/tgwp-agent version)\"}" \
  {{sq (printf "%s/api/v1/install/%s/register" .PanelURL .InstallToken)}})"
{{end}}NODE_TOKEN="$(printf '%s' "$REG" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')"
if [[ -z "$NODE_TOKEN" ]]; then echo "registration failed: $REG" >&2; exit 1; fi

install -d -m 0700 /etc/tgwp-agent /var/lib/tgwp-agent
umask 077
cat > /etc/tgwp-agent/agent.env <<EOF
TGWP_PANEL_URL=$PANEL_URL
TGWP_TOKEN=$NODE_TOKEN
{{if .IsTelemt}}TGWP_ENGINE=telemt
{{else}}TGWP_TPROXY_VERSION=$TPROXY_COMMIT
{{end}}EOF
umask 022
cat > /etc/systemd/system/tgwp-agent.service <<'EOF'
[Unit]
Description=WEB proxy panel node agent
After=network-online.target {{if .IsTelemt}}telemt.service{{else}}tproxy-server.service{{end}}
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/tgwp-agent/agent.env
ExecStart=/usr/local/bin/tgwp-agent
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
{{if .IsTelemt}}# Caddy FIRST, and only once it actually serves the hostname over TLS. telemt learns the TLS
# fingerprint of its tls_domain by connecting to it on 443 at startup, and a runtime reload
# refuses to activate a generation whose TLS-front profile is still the built-in fallback
# ("TLS-front profiles are not ready for domains: ..."). Starting telemt before Caddy holds a
# certificate makes the node's first applies roll back; if the A record was never pointed at
# this host, Caddy never gets a certificate at all and every apply rolls back forever - so this
# wait is also the check that DNS is right, and it fails loudly instead of exiting 0.
systemctl enable caddy
systemctl restart caddy
CADDY_READY=0
for i in $(seq 1 120); do
  if curl -sS -o /dev/null --max-time 5 --resolve "$NODE_HOSTNAME:443:127.0.0.1" "https://$NODE_HOSTNAME/" 2>/dev/null; then
    CADDY_READY=1
    break
  fi
  sleep 1
done
if [[ "$CADDY_READY" -ne 1 ]]; then
  echo "Caddy did not serve https://$NODE_HOSTNAME/ with a valid certificate within 120s." >&2
  echo "The A record for $NODE_HOSTNAME must already point at this host and ports 80/443 must be reachable before running this installer." >&2
  journalctl -u caddy -n 30 --no-pager >&2 || true
  exit 1
fi

systemctl enable --now telemt
# The control API is the agent's only channel to the relay, so the agent is not started until
# telemt reports itself ready on it - listening is not the same as able to serve. The token
# file is written by init-node, 0600; tr strips the trailing newline so the header is the
# exact value telemt compares against. The header goes in on stdin (-H @-) rather than as an
# argument, so the token never appears in /proc/*/cmdline, and it is never echoed.
TELEMT_API_TOKEN="$(tr -d '\r\n' < /etc/telemt/api.token)"
TELEMT_STATUS=000
for i in $(seq 1 60); do
  TELEMT_STATUS="$(curl -s -o /dev/null -w '%{http_code}' -H @- http://127.0.0.1:9091/v1/health/ready <<<"Authorization: $TELEMT_API_TOKEN")" || TELEMT_STATUS=000
  if [[ "$TELEMT_STATUS" == "200" ]]; then break; fi
  if [[ "$i" -eq 60 ]]; then
    echo "telemt did not report ready on /v1/health/ready within 60s (last HTTP status $TELEMT_STATUS)" >&2
    journalctl -u telemt -n 30 --no-pager >&2 || true
    exit 1
  fi
  sleep 1
done
unset TELEMT_API_TOKEN
systemctl enable --now tgwp-agent
echo "Node $NODE_HOSTNAME registered with the panel."
echo "WEB: https://$NODE_HOSTNAME/  Fake-TLS: $NODE_HOSTNAME:$CLASSIC_PORT (SNI $TLS_DOMAIN)"
{{else}}systemctl restart mtproxy tproxy-server
systemctl enable --now tgwp-agent
echo "Node $NODE_HOSTNAME registered with the panel."
{{end -}}
