DATABASE_URL=postgres://tgwp:tgwp@localhost:5432/tgwp?sslmode=disable
# 32 random bytes, base64: openssl rand -base64 32
MASTER_KEY=
MASTER_KEY_VERSION=1
# Set only while running `panel keys rotate` (see docs/runbook.md, "Master key
# rotation"); 32 random bytes, base64, same as MASTER_KEY. Not read anywhere else.
MASTER_KEY_NEW=
SESSION_SECRET=
PANEL_HTTP_ADDR=:8080
PANEL_PUBLIC_URL=http://localhost:8080
DATA_DIR=./data
NODE_DRIVER=gateway
# Required when NODE_DRIVER=gateway: /metrics is served on the public domain and the
# panel refuses to start without it. Generate with: openssl rand -hex 32
METRICS_TOKEN=
TPROXY_COMMIT=52a5feb7fac38f68da5afef9cedd9b3bfc8473ca
# The telemt release that telemt nodes install, and the sha256 of its
# telemt-x86_64-linux-gnu.tar.gz asset. The node install script verifies the download
# against this checksum before it runs anything, so it is required when
# NODE_DRIVER=gateway. Change both together when you move to a new telemt version.
TELEMT_VERSION=3.5.5
TELEMT_SHA256_X86_64=2d5fb35b526f548bb6ffe7689cdf4f51f4108b97014be1b3b4186a58ab28d605
FEATURE_TOTP=false
LOG_LEVEL=info
APPLY_INTERVAL=45
OFFLINE_AFTER=90
# Update check: the panel reads the latest release and the star count of this
# GitHub repository (two GETs against api.github.com, cached for an hour) and shows a
# "new version" hint in the topbar. Nothing about your installation is sent. Set
# UPDATE_CHECK=false to disable it entirely. GITHUB_TOKEN is optional: a token with no
# scopes raises the API rate limit from 60 to 5000 requests/hour; it is never logged.
GITHUB_REPO=greenpandorik/tgproxy-panel
GITHUB_TOKEN=
UPDATE_CHECK=true
# Compose deployment (deploy/docker-compose.yml) - not read by the panel binary
PANEL_DOMAIN=localhost
# sha256 of the same telemt release's telemt-x86_64-linux-musl.tar.gz asset. Only the
# fakenode-telemt demo image uses it (the musl build is static, so it runs on a slim
# Debian image); real nodes install the gnu asset above. Move both together when you
# change TELEMT_VERSION.
TELEMT_SHA256_MUSL_X86_64=6be65484bb1b319798919b746e72d611d32e92aa07347c390fffc5127ff6615f
# ACME account email for Caddy; certificate-expiry notices go here. Empty registers
# anonymously with the ACME CA, which means no expiry warnings.
ACME_EMAIL=
# tests
TEST_DATABASE_URL=postgres://tgwp:tgwp@localhost:5432/tgwp_test?sslmode=disable
